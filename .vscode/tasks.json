{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "E:/Programs/usr/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "../Executor.cpp",
                "../Data/Mapper.cpp",
                "../Data/Date.cpp",
                "../Data/Record.cpp",
                "../Sorting/Sorter.cpp",
                "../Sorting/CountingSort.cpp",
                "../Sorting/HeapSort.cpp",
                "../Sorting/MergeSort.cpp",
                "../Sorting/QuickSort.cpp",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}